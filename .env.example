# ── Database Configuration ──
HINDSIGHT_DB_USER=hindsight_user
HINDSIGHT_DB_PASSWORD=change-me-to-secure-password
HINDSIGHT_DB_NAME=hindsight_db
# HINDSIGHT_DB_PORT=5438
# ── Kalau password ada karakter spesial (#, @, :, /), set full URL manual di bawah
# ── (URL-encode karakternya: # → %23, @ → %40, : → %3A, / → %2F)
# HINDSIGHT_DATABASE_URL=postgresql://hindsight_user:pass%23word@db:5432/hindsight_db

# ── Hindsight Version (tag: latest, or version: latest-slim) ──
HINDSIGHT_VERSION=latest-slim

# ── App Ports ──
# HINDSIGHT_HTTP_PORT=8888
# HINDSIGHT_GRPC_PORT=9999

# ── CPU Limits (biar embedder + reranker nggak makan semua core) ──
HINDSIGHT_CPU_LIMIT=4.0
HINDSIGHT_OMP_NUM_THREADS=4
# HINDSIGHT_TOKENIZERS_PARALLELISM=true

# ── LLM: Custom OpenAI-compatible (DeepSeek example) ──
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
HINDSIGHT_API_LLM_API_KEY=sk-your-deepseek-api-key
HINDSIGHT_API_LLM_MODEL=deepseek-v4-flash

# Alternative providers (uncomment and configure):
# ── DeepSeek via OpenRouter ──
# HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
# HINDSIGHT_API_LLM_API_KEY=sk-or-v1-xxx
# HINDSIGHT_API_LLM_MODEL=deepseek/deepseek-chat

# ── Groq ──
# HINDSIGHT_API_LLM_BASE_URL=https://api.groq.com/openai/v1
# HINDSIGHT_API_LLM_API_KEY=gsk_xxx
# HINDSIGHT_API_LLM_MODEL=llama-3.3-70b-versatile

# ── Local LLM (llama.cpp / Ollama / LM Studio) ──
# HINDSIGHT_API_LLM_BASE_URL=http://localhost:1234/v1
# HINDSIGHT_API_LLM_API_KEY=not-needed
# HINDSIGHT_API_LLM_MODEL=llama-3.1-8b-instruct

# ── REST API authentication for coding-agent hooks (optional) ──
# Enable both settings to make the unified coding-agent package authenticate
# its REST calls with a Bearer token.
# HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
# HINDSIGHT_API_TENANT_API_KEY=replace-with-a-long-random-rest-api-key

# ── Direct remote MCP authentication (optional) ──
# Used only when an MCP client connects to /mcp/<bank-id>/ directly.
# HINDSIGHT_API_MCP_AUTH_TOKEN=replace-with-a-long-random-mcp-token

# ── Local embeddings & reranker (baked into the image) ──
HINDSIGHT_EMBEDDING_MODEL=BAAI/bge-m3
HINDSIGHT_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Other model examples (change both HINDSIGHT_EMBEDDING_MODEL and build-arg EMBEDDER):
# HINDSIGHT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HINDSIGHT_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# HINDSIGHT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# HINDSIGHT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
