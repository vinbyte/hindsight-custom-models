# Custom Hindsight image with local models baked in.
#
# Use this pattern in production when you run a non-default embedder or
# reranker. Baking models into the image removes the runtime dependency on
# HuggingFace and lets the container registry handle caching per node, so
# you don't need a model-cache PVC.
#
# Built on top of the slim image so only the deps and models you actually
# use end up in the final image.
ARG HINDSIGHT_VERSION=0.10.1-slim
FROM ghcr.io/vectorize-io/hindsight:${HINDSIGHT_VERSION}

# Optional Codex CLI support for the docker-compose.codex.yaml overlay. Keeping
# it behind a build argument leaves the base image unchanged for other LLMs.
ARG INSTALL_CODEX=false
USER root
ENV PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"
RUN if [ "$INSTALL_CODEX" = "true" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends nodejs \
      && node --version \
      && npm --version \
      && npm install --global @openai/codex \
      && command -v codex \
      && codex --version \
      && rm -rf /var/lib/apt/lists/*; \
    fi
USER 1000

# Install the local embedding dependencies and FlashRank. PyTorch's CPU index
# takes priority over PyPI, preventing CUDA/NVIDIA wheels on CPU servers.
ARG PYTORCH_CPU_INDEX=https://download.pytorch.org/whl/cpu
RUN uv pip install --python /app/api/.venv/bin/python --no-cache \
    --extra-index-url "${PYTORCH_CPU_INDEX}" \
    'sentence-transformers>=5.0.0' \
    'torch>=2.6.0' \
    'flashrank>=0.2.10'

# Pre-download the models you want to use. Override via build args.
ARG EMBEDDER=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARG RERANKER=ms-marco-MultiBERT-L-12
ENV HINDSIGHT_API_RERANKER_FLASHRANK_CACHE_DIR=/home/hindsight/.cache/flashrank
ENV HF_HUB_DOWNLOAD_TIMEOUT=600
RUN mkdir -p /home/hindsight/.cache/flashrank && \
    /app/api/.venv/bin/python -c "\
from sentence_transformers import SentenceTransformer; \
from flashrank import Ranker; \
SentenceTransformer('${EMBEDDER}'); \
Ranker(model_name='${RERANKER}', cache_dir='/home/hindsight/.cache/flashrank')"
